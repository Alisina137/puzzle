# Local dev defaults for Base44 preview. Real secrets (if any) are delivered
# via /run/base44/app.env, which is listed AFTER this file in compose and wins.

# Database (local postgres compose service)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/puzzlebook_dev

# Redis (local redis compose service, used by BullMQ via ioredis)
REDIS_URL=redis://redis:6379

# NextAuth (local JWT signing secret — not a user secret)
NEXTAUTH_SECRET=vqpQ0m52BonHXa4mfIai/Z834Mo7Sx6HEevTH3hIlrs=

# File storage
STORAGE_PATH=./storage

# Upstash Redis REST placeholders. The Upstash client is constructed at
# module load in src/lib/redis.ts; these prevent an import-time throw. The
# Upstash REST client is only referenced by src/lib/cache.ts, which is not
# imported anywhere, so these values are never actually called.
UPSTASH_REDIS_REST_URL=http://redis:6379
UPSTASH_REDIS_REST_TOKEN=local-dev-placeholder
