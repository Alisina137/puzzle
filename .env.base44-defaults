# Base44 dev defaults — placeholders so the app boots without external credentials.
# Real secrets (if any) are delivered via /run/base44/app.env and override these.

# Auth
NEXTAUTH_SECRET=base44-dev-secret-change-me
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash (dummy — local dev uses REDIS_URL via ioredis/BullMQ)
UPSTASH_REDIS_REST_URL=http://redis:8080
UPSTASH_REDIS_REST_TOKEN=dummy-token

# File storage
STORAGE_PATH=./storage
