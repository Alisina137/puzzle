generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]
  exports   Export[]

  @@map("users")
}

model Book {
  id             String          @id @default(cuid())
  userId         String
  title          String          @db.VarChar(255)
  theme          String          @db.VarChar(100)
  puzzleCount    Int             @default(0)
  status         String          @default("pending")

  // V2 NEW FIELDS
  targetAudience String?         @db.VarChar(50)
  difficultyLevel String?        @db.VarChar(50)
  generationSettings Json?

  qualityScore   Decimal?        @db.Decimal(5, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookPuzzles    BookPuzzle[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exports        Export[]
  generationJobs GenerationJob[]
  qualityReport  BookQualityReport?
  kdpConfig      KDPConfiguration?
  regenerationRequests RegenerationRequest[]  // <-- ADD THIS LINE

  @@index([userId])
  @@index([status])
  @@index([targetAudience])
  @@index([difficultyLevel])
  @@map("books")
}
model Puzzle {
  id           String          @id @default(cuid())
  type         String          @default("wordsearch")
  data         Json
  difficulty   String?         @default("medium")

  // V2 NEW FIELDS
  difficultyScore Int?         @default(0)
  difficultyLabel String?      @db.VarChar(20)
  validationStatus String?     @db.VarChar(20)
  qualityMetrics Json?
  fingerprint   String?        @db.VarChar(255)

  qualityScore Decimal?        @db.Decimal(5, 2)
  createdAt    DateTime        @default(now())
  bookPuzzles  BookPuzzle[]
  versions     PuzzleVersion[]
  regenerationRequests RegenerationRequest[]  // <-- ADD THIS LINE

  @@index([type])
  @@index([difficultyScore])
  @@index([fingerprint])
  @@map("puzzles")
}

model PuzzleVersion {
  id            String       @id @default(cuid())
  puzzleId      String
  versionNumber Int
  data          Json
  isActive      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  bookPuzzles   BookPuzzle[]
  puzzle        Puzzle       @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([puzzleId, versionNumber])
  @@index([puzzleId])
  @@map("puzzle_versions")
}

model BookPuzzle {
  id              String        @id @default(cuid())
  bookId          String
  puzzleId        String
  puzzleVersionId String
  position        Int
  displayNumber   Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  book            Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  puzzle          Puzzle        @relation(fields: [puzzleId], references: [id])
  puzzleVersion   PuzzleVersion @relation(fields: [puzzleVersionId], references: [id])
  solution        Solution?

  @@unique([bookId, position])
  @@unique([bookId, displayNumber])
  @@index([bookId, position])
  @@map("book_puzzles")
}

model Solution {
  id           String     @id @default(cuid())
  bookPuzzleId String     @unique
  data         Json
  validatedAt  DateTime?
  isValid      Boolean?
  createdAt    DateTime   @default(now())
  bookPuzzle   BookPuzzle @relation(fields: [bookPuzzleId], references: [id], onDelete: Cascade)

  @@map("solutions")
}

model Theme {
  id         String      @id @default(cuid())
  name       String      @unique @db.VarChar(100)
  categoryId String?
  isCustom   Boolean     @default(false)
  wordCount  Int         @default(0)

  // V2 NEW FIELDS
  description String?     @db.VarChar(500)
  difficulty  String?     @db.VarChar(20)
  tags        String[]
  usageCount  Int         @default(0)
  isPublic    Boolean     @default(true)

  createdAt  DateTime    @default(now())
  words      ThemeWord[]
  category   ThemeCategory? @relation(fields: [categoryId], references: [id])

  @@index([name])
  @@index([isPublic])
  @@index([categoryId])
  @@map("themes")
}

model ThemeWord {
  id         String   @id @default(cuid())
  themeId    String
  word       String   @db.VarChar(50)
  difficulty String?  @default("medium")
  createdAt  DateTime @default(now())
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, word])
  @@index([themeId])
  @@map("theme_words")
}

model GenerationJob {
  id             String              @id @default(cuid())
  bookId         String
  status         String              @default("pending")
  requestedCount Int
  generatedCount Int                 @default(0)
  validCount     Int                 @default(0)
  rejectedCount  Int                 @default(0)
  error          String?
  log            Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  attempts       GenerationAttempt[]
  book           Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([status])
  @@map("generation_jobs")
}

model GenerationAttempt {
  id              String        @id @default(cuid())
  generationJobId String
  puzzleId        String?
  attemptNumber   Int
  status          String        @default("pending")
  error           String?
  createdAt       DateTime      @default(now())
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@index([generationJobId])
  @@map("generation_attempts")
}

model Export {
  id                String    @id @default(cuid())
  bookId            String
  userId            String
  format            String    @default("pdf")
  status            String    @default("pending")
  url               String?
  filesize          Int?
  preflightPassed   Boolean?
  preflightErrors   Json?
  preflightWarnings Json?
  options           Json?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  book              Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
  @@map("exports")
}

model Template {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  description  String?
  isDefault    Boolean  @default(false)
  config       Json
  previewImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isDefault])
  @@map("templates")
}

// ===== V2 NEW MODELS =====

model ConfigurationTemplate {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(100)
  audience         String   @db.VarChar(50)    // Children, Teenagers, Adults, Seniors, PuzzleEnthusiasts
  difficulty       String   @db.VarChar(50)    // Easy, Medium, Hard, Expert
  config           Json                       // { gridSize, wordsPerPuzzle, minWordLength, maxWordLength, directions, allowReverse, overlap, vocabularyLevel }
  isDefault        Boolean  @default(false)
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([audience, difficulty])
  @@index([audience, difficulty])
  @@map("configuration_templates")
}

model ThemeCategory {
  id         String   @id @default(cuid())
  name       String   @unique @db.VarChar(100)
  description String?
  icon       String?  @db.VarChar(50)
  createdAt  DateTime @default(now())
  themes     Theme[]

  @@map("theme_categories")
}

model BookQualityReport {
  id               String   @id @default(cuid())
  bookId           String
  score            Decimal  @db.Decimal(5, 2)
  totalPuzzles     Int
  validPuzzles     Int
  verifiedSolutions Int
  duplicates       Int
  difficultyConsistency Decimal? @db.Decimal(5, 2)
  warnings         Json?
  recommendations  Json?
  generatedAt      DateTime @default(now())
  book             Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId])
  @@index([bookId])
  @@map("book_quality_reports")
}

model RegenerationRequest {
  id               String   @id @default(cuid())
  bookId           String
  puzzleId         String
  reason           String   @db.VarChar(255)
  requestedAt      DateTime @default(now())
  processedAt      DateTime?
  status           String   @default("pending") // pending, processing, completed, failed
  newPuzzleId      String?
  book             Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  puzzle           Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([status])
  @@map("regeneration_requests")
}

model KDPConfiguration {
  id               String   @id @default(cuid())
  bookId           String
  trimSize         String   @db.VarChar(50)   // 6x9, 8.5x11, etc.
  hasBleed         Boolean  @default(false)
  marginTop        Int      @default(72)      // in points
  marginBottom     Int      @default(72)
  marginLeft       Int      @default(72)
  marginRight      Int      @default(72)
  gutter           Int      @default(0)
  largePrint       Boolean  @default(false)
  pageNumbering    Boolean  @default(true)
  solutionPlacement String  @default("end")   // end, after_each, none
  includeSolution  Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  book             Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId])
  @@map("kdp_configurations")
}