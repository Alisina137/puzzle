# Copy this to .env and fill in values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secret"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File Storage
STORAGE_PATH="./storage"

# Optional: Email (for future auth features)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""

# AI Providers (at least one is required for vocabulary generation)
# OpenAI = primary provider
# Gemini = fallback provider (used automatically if OPENAI_API_KEY is missing
#          or if an OpenAI request fails with a recoverable error)
OPENAI_API_KEY=""
OPENAI_MODEL=""           # optional, defaults to gpt-4o
OPENAI_API_BASE_URL=""     # optional, defaults to https://api.openai.com/v1

GEMINI_API_KEY=""
GEMINI_MODEL=""           # optional, defaults to gemini-2.5-flash
